# VoltReserve Frontend Configuration Example
# Copy this file to .env and configure your local environment settings

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8080/api

# OpenStreetMap Tile Layer
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Optional OpenRouteService API Key (leave empty to use standard OSM / OSRM engine)
VITE_ROUTING_API_KEY=your_openrouteservice_api_key_here
