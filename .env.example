# ==============================================================================
# VoltReserve Production Environment Configuration Template
# ==============================================================================
# NOTE: Never commit sensitive credentials or actual passwords to version control.
# Copy this file to .env and configure values for your environment.

# ------------------------------------------------------------------------------
# 1. Backend Server & Port Settings
# ------------------------------------------------------------------------------
# PORT is automatically injected by hosting platforms (e.g. Render, Railway, Heroku)
PORT=8080

# ------------------------------------------------------------------------------
# 2. Production MySQL Database Settings
# ------------------------------------------------------------------------------
# Full JDBC URL (useSSL=true in production; useSSL=false for local development)
SPRING_DATASOURCE_URL=jdbc:mysql://your-production-db-host:3306/voltreserve?useSSL=true&requireSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=voltreserve_admin
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# Connection Pooling (HikariCP)
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# Hibernate DDL Mode ('none' for production with SQL schema initialization; 'update' for dev)
SPRING_JPA_HIBERNATE_DDL_AUTO=none

# ------------------------------------------------------------------------------
# 3. Security, Authentication & JWT Secret
# ------------------------------------------------------------------------------
# Generate a cryptographically strong 256-bit secret key (e.g., openssl rand -hex 32)
JWT_SECRET=your_production_256_bit_jwt_secret_key_minimum_64_characters
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of allowed frontend production domains)
CORS_ALLOWED_ORIGINS=https://voltreserve.onrender.com,https://voltreserve.vercel.app,http://localhost:5173

# Reservation Hold Window in minutes
HOLD_DURATION_MINUTES=10

# ------------------------------------------------------------------------------
# 4. Frontend Environment Variables (Vite)
# ------------------------------------------------------------------------------
# Base API URL pointing to your deployed backend
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api

# Map & Navigation Configuration
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Optional Routing Engine API Key (OpenRouteService - leave empty to use default OSRM)
VITE_ROUTING_API_KEY=
